# Copy to .env for `npm start` or Docker Compose. Never commit .env.
# Variables that are already set in the environment win over this file.

# Public EOL Radar API. There is no API key.
EOL_API_BASE=https://eolradar.dev

# Slack app → Basic Information → Signing Secret.
# Required for HTTP slash commands. Not used by Socket Mode.
SLACK_SIGNING_SECRET=

# Slack app → OAuth & Permissions → Bot User OAuth Token (xoxb-...).
# Used by the Monday digest (chat.postMessage).
SLACK_BOT_TOKEN=

# Channel id that receives the Monday digest (C0123ABCDEF).
# Leave empty to skip the digest.
SLACK_DIGEST_CHANNEL=

# Comma-separated service slugs, for example eks,rds-postgresql,lambda.
# all (or empty) includes every service.
DIGEST_SERVICES=all

# Slack app → Basic Information → App-Level Tokens, scope connections:write.
# Set this to run Slack Socket Mode (no public request URL). Leave empty for HTTP.
SLACK_APP_TOKEN=

PORT=8080
HOST=0.0.0.0

# memory (default), file, or sqlite.
# file and sqlite need a writable STORE_PATH. memory does not.
STORE=memory
# STORE_PATH=./data/eolradar-bot.json

# In-process digest schedule, UTC. This is the same instant as the Worker cron.
# Set to off when another scheduler (the Worker cron or GitHub Actions) posts the digest.
DIGEST_CRON=0 14 * * MON

# If the process starts this many minutes after a missed slot, post that slot once.
DIGEST_CATCHUP_MINUTES=15
